# ===================================
# Environment Variables Template
# ===================================
# Copy this file to .env and fill in your actual values
# cp env.template .env

# ===================================
# Azure Communication Services
# ===================================
ACS_CONNECTION_STRING=your_acs_connection_string_here
COGNITIVE_SERVICE_ENDPOINT=https://your-cognitive-service.cognitiveservices.azure.com/
AGENT_PHONE_NUMBER=your_agent_phone_number_here
VOICE_NAME=en-US-JennyNeural

# ===================================
# Azure OpenAI
# ===================================
AZURE_OPENAI_SERVICE_KEY=your_openai_service_key_here
AZURE_OPENAI_SERVICE_ENDPOINT=https://your-openai-service.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_MODEL_NAME=gpt-4o-realtime-preview
AZURE_OPENAI_DEPLOYMENT_MODEL=gpt-4o-realtime-preview
AZURE_OPENAI_SERVICE_API_VERSION=2024-10-01-preview

# ===================================
# Application Settings
# ===================================
CALLBACK_URI_HOST=https://your-public-url.com
END_SILENCE_TIMEOUT=0.5

# ===================================
# CosmosDB
# ===================================
COSMOS_DB_DATABASE_NAME=CallAutomationDB
COSMOS_DB_CONTAINER_NAME=Sessions
COSMOS_DB_URL=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DB_KEY=your_cosmos_db_key_here

# ===================================
# Redis Cache
# ===================================
REDIS_URL=your-redis-url.redis.cache.windows.net:6380
REDIS_PASSWORD=your_redis_password_here

# ===================================
# AI Search (Optional)
# ===================================
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_search_key_here
AZURE_SEARCH_INDEX=your_index_name
AZURE_SEARCH_QUERY_KEY=your_query_key_here

# ===================================
# Azure Maps (Optional)
# ===================================
AZURE_MAPS_KEY=your_maps_key_here

# ===================================
# Default Phone Numbers
# ===================================
TARGET_PHONE_NUMBER=+1234567890
AGENT_PHONE_NUMBER=+1234567890

# ===================================
# Azure Voice Live API (Non-Agent Mode)
# ===================================
# Used when use_agent: false (default)
AZURE_VOICE_LIVE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_VOICE_LIVE_DEPLOYMENT=gpt-4o
VOICE_LIVE_MODEL=gpt-4o
AZURE_VOICE_LIVE_API_VERSION=2025-10-01
AZURE_VOICE_LIVE_API_KEY=your_voice_live_api_key_here

# ===================================
# AI Foundry Agent Service (Agent Mode - Optional)
# ===================================
# Only required if you want to use Agent Mode (use_agent: true)
# Leave empty or omit these variables to use Non-Agent Mode only
#
# To set up Agent Mode:
# 1. Create an Azure AI Foundry resource
# 2. Create a project in Azure AI Foundry portal
# 3. Create an agent in the project
# 4. Get the agent ID from the agent details
# 5. Get an access token (API key or AAD token)
#
# Agent mode uses Azure AD authentication automatically
# Run 'az login' to authenticate, or configure managed identity in production
AI_FOUNDRY_PROJECT_NAME=your_project_name
AI_FOUNDRY_AGENT_ID=your_agent_id
# AI_FOUNDRY_AGENT_ACCESS_TOKEN is NOT needed - Azure AD token is obtained automatically

# ===================================
# Security (Optional)
# ===================================
SHOULD_USE_KEYS=False

