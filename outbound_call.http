###

### RECRUITMENT INTERVIEW - conduct phone screening for Full Stack Developer role
# persona: "recruitment" activates the recruitment interview system message
# The AI will interview based on Sarah Mitchell's CV and the CloudScale Innovations job description
POST http://localhost:8000/api/initiateOutboundCall
Content-Type: application/json

{
    "phone_number": "+447427404900",
    "customer_name": "Sarah Mitchell",
    "customer_email": "sarah.mitchell@email.com",
    "persona": "recruitment",
    "use_agent": false
}

###

### RECRUITMENT INTERVIEW with AGENT MODE
# Uses Azure AI Foundry Agent with recruitment persona
POST http://localhost:8000/api/initiateOutboundCall
Content-Type: application/json

{
    "phone_number": "+447427404900",
    "customer_name": "Sarah Mitchell",
    "customer_email": "sarah.mitchell@email.com",
    "persona": "recruitment",
    "use_agent": true
}
